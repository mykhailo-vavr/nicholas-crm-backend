{
  "name": "nicholas-crm-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rimraf ./dist && nest build",
    "start:dev": "nest start --watch",
    "start:prod": "npm run build && node dist/main",
    "start:docker:dev": "docker compose -f docker-compose.dev.yml up",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "dotenv -e .env.prisma.studio -- prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint --report-unused-disable-directives --max-warnings=0",
    "postinstall": "npm run prisma:generate",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "prisma": {
    "schema": "src/database/schema.prisma"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "3.4.1",
    "@nestjs/axios": "4.0.0",
    "@nestjs/common": "11.1.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.3",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/platform-express": "11.1.3",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.9.0",
    "axios": "1.9.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cls-hooked": "4.2.2",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "nestjs-zod": "5.0.0-beta.20250519T201559",
    "prettier-plugin-organize-imports": "4.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "superjson": "2.2.2",
    "zod": "3.25.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "9.28.0",
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.1.3",
    "@types/bcrypt": "5.0.2",
    "@types/cls-hooked": "4.3.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/parser": "8.34.0",
    "dotenv-cli": "8.0.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.3",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.4.1",
    "globals": "16.2.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "prisma": "6.9.0",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "supertest": "7.1.1",
    "ts-jest": "29.3.4",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0"
  }
}
